<odoo>
    <record id="res_config_settings_inheri_view_form" model="ir.ui.view">
        <field name="name">res.config.setting.inherit.form.saas</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval='20'/>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">

                <app string="Odoo Saas Kit" data-string="Odoo Saas Kit" name="odoo_saas_kit" groups="odoo_saas_kit.group_saas_manager">
                    <block title="Default Configuration for Odoo Saas KIT" id="saas_kit_config" class="saas_kit_setting_block" name="saas_kit_setting_container">

                        <setting class="col-12" id="saas_kit_auto_create_client" string="Scheduled Client Creation" help="Automatically create clients from contract via Scheduler.">
                            <field name="auto_create_client"/>
                        </setting>
                        <setting>
                        </setting>

                        <setting class="col-12" id="saas_kit_restrict_cart" string="Restrict Cart for Single Saas Plan" help="The customer will not be able to add more than one saas plan product to the cart.">
                            <field name="restrict_add_to_cart"/>
                        </setting>
                        
                        <setting class="col-12" id="enable_contract_renewal" string="Enable Contract Renewal Button" help="If enabled, the Renew button will be visible on the saas contract portal.">
                            <field name="enable_contract_renewal"/>
                            <div class="content-group" invisible="not enable_contract_renewal">
                                <div class="row mt16">
                                    <div class="col-lg-4">
                                        <label for="renew_btn_enable_days" string="Visible From" class="o_light_label"/> 
                                    </div>
                                    <div class="col-lg-8">
                                        <field class="oe_inline" name="renew_btn_enable_days" required="1"/> Days
                                    </div>
                                </div>
                                <div class="text-muted">
                                    Set the value to -1 to make the button visible from the date of purchase.<br />
                                    Set the value to 0 to make the button visible on the date of renewal.
                                </div>
                            </div>
                        </setting>

                        <setting id="saas_kit_renew_mail"  class="col-12" string="Send Expiry Reminder to expired Saas Contracts" help=" Automatically send renew mail for continue the contract after expiry.">
                            <field name="enable_renew_mail"/>
                            <div class="col-md-12 o_setting_box mt32" id="saas_kit_renew_mail_div" invisible="not enable_renew_mail">
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="o_setting_left_pane">
                                            <field name="enable_renew_mail_paid_contract"/>
                                        </div>
                                        <label for="enable_renew_mail_paid_contract" string="For Paid Contract"/>
                                    </div>
                                    <br/>
                                    <br/>
                                    <div class="row">
                                        <div class="col-md-12" invisible="not enable_renew_mail_paid_contract">
                                            <div>
                                                <label for="renew_period_paid_contract" string="Renew Reminders ends after (days)" class="o_light_label"/>
                                                <field class="oe_inline ms-2" name="renew_period_paid_contract" required="1"/>
                                            </div>
                                            <div class="text-muted">
                                                For Paid Contract Renew mails will sent to Customer.
                                            </div>
                                            <br/>
                                            <div>
                                                <label for="no_of_mails_paid_contract" string="No of Expiry mails" class="o_light_label"/>
                                                <field class="oe_inline ms-2" name="no_of_mails_paid_contract" required="1" value="3"/>
                                            </div>
                                            <div class="text-muted">
                                                No of mail should be less than or equal to Renew period.
                                            </div>
                                            <br/>
                                            <div>
                                                <field name="stop_client_paid_contract" class="d-inline"/>
                                                <label for="stop_client_paid_contract" string="Automatic Disable expired Saas Client Instances" class="d-inline o_light_label"/>
                                            </div>
                                            <div class="row mt-2" invisible="not stop_client_paid_contract">
                                                <div class="col-11 offset-1">
                                                    <div invisible="not stop_client_paid_contract">
                                                        <field name="drop_paid_contract"/>
                                                        <label for="drop_paid_contract" string="Delete Client Instances" invisible="not stop_client_paid_contract" class="o_light_label"/>
                                                        <br/>
                                                        <div class="text-muted" invisible="not stop_client_paid_contract">
                                                            If selected related Saas Client container and database would be dropped.
                                                        </div>
                                                    </div>
                                                    <div class="row mt-2" invisible="not drop_paid_contract">
                                                        <div class="col-11 offset-1" >
                                                            <label for="buffer_paid_contract" string="Buffer Period" class="o_light_label"/>
                                                            <field class="oe_inline ms-2" name="buffer_paid_contract" required="1" value="3"/>
                                                            <div class="text-muted" invisible="not drop_paid_contract">
                                                                Disabled client would be dropped after this Buffer Period
                                                            </div>
                                                        </div>

                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                            
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
