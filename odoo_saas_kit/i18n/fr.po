#. module: odoo_saas_kit
#: model:mail.template,body_html:odoo_saas_kit.contract_renew_mail_template
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p>Dear <t t-esc=\"object.partner_id.name\"/>\n"
"\n"
"                        <t t-if=\"object.partner_id.parent_id\">\n"
"                            (<i><t t-esc=\"object.partner_id.parent_id.name\"/></i>)\n"
"                        </t>                        \n"
"                    ,</p>\n"
"                    <p>We want to inform you that your Contract <t t-esc=\"object.name\"/> for <t t-esc=\"object.saas_client.client_url\"/> was expired on <t t-esc=\"object.next_invoice_date\"/> .</p>\n"
"                    <p>\n"
"                        Please extend your contract  before <t t-esc=\"object.renew_deadline_date\"/> to continue services of plan else your instance will be drop. You can buy any number of cycles for the plan.\n"
"                    </p>\n"
"                    <p>CONTRACT DETAILS</p>                \n"
"                    <p>\n"
"                        Commencement Date: <t t-esc=\"object.start_date\"/><br/>\n"
"                        Expiry Date: <t t-esc=\"object.next_invoice_date\"/><br/>\n"
"                    </p>\n"
"                    <p>If you have any queries or issues, please contact our support team.</p>\n"
"                    <br/><br/>\n"
"                    <br/>\n"
"                    <p>Thank you,</p>\n"
"                    <p style=\"color:#888888;\">\n"
"                    </p>\n"
"                </div>\n"
"                \n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p>Bonjour <t t-esc=\"object.partner_id.name\"/>\n"
"\n"
"                        <t t-if=\"object.partner_id.parent_id\">\n"
"                            (<i><t t-esc=\"object.partner_id.parent_id.name\"/></i>)\n"
"                        </t>                        \n"
"                    ,</p>\n"
"                    <p>Nous vous informons que votre contrat <t t-esc=\"object.name\"/> pour <t t-esc=\"object.saas_client.client_url\"/> a expiré le <t t-esc=\"object.next_invoice_date\"/> .</p>\n"
"                    <p>\n"
"                        Veuillez renouveler votre contrat avant <t t-esc=\"object.renew_deadline_date\"/> afin de continuer à bénéficier des services de l’offre ; à défaut, votre instance sera supprimée. Vous pouvez acheter autant de cycles que nécessaire pour l’offre.\n"
"                    </p>\n"
"                    <p>DÉTAILS DU CONTRAT</p>                \n"
"                    <p>\n"
"                        Date de début : <t t-esc=\"object.start_date\"/><br/>\n"
"                        Date d’expiration : <t t-esc=\"object.next_invoice_date\"/><br/>\n"
"                    </p>\n"
"                    <p>Pour toute question ou difficulté, veuillez contacter notre équipe d’assistance.</p>\n"
"                    <br/><br/>\n"
"                    <br/>\n"
"                    <p>Merci,</p>\n"
"                    <p style=\"color:#888888;\">\n"
"                    </p>\n"
"                </div>\n"
"                \n"
"            "

#. module: odoo_saas_kit
#: model:mail.template,body_html:odoo_saas_kit.contract_expiry_template
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p>Dear <t t-esc=\"object.partner_id.name\"/>\n"
"                        <t t-set=\"access_url\" t-value=\"object.get_contract_url()\"/>\n"
"    \n"
"                        <t t-if=\"object.partner_id.parent_id\">\n"
"                            (<i><t t-esc=\"object.partner_id.parent_id.name\"/></i>)\n"
"                        </t>\n"
"                    ,</p>\n"
"                    <p>We want to inform you that your Plan subscription for <t t-esc=\"object.plan_id.name\"/> is expired.</p>\n"
"                    <p>\n"
"                        Please extend your contract to continue services of plan. You can buy any number of cycles for the plan.\n"
"                    </p>                \n"
"                    <p>\n"
"                        Please buy the subscription before ending of your plan's instance.\n"
"                    </p>\n"
"                    <br/>\n"
"                    <p>\n"
"                        To Renew the current plan, Click <a t-att-href=\"access_url\">Renew Now</a>\n"
"                    </p>\n"
"                    <br/>\n"
"                    <p>\n"
"                        Commencement Date: <t t-esc=\"object.start_date\"/><br/>\n"
"                        Expiry Date: <t t-esc=\"object.next_invoice_date\"/><br/>\n"
"                    </p>\n"
"                    <p>\n"
"                        If you have any queries or issues, please contact our support team.\n"
"                    </p>\n"
"                    <br/><br/>\n"
"                    <br/>\n"
"                    <p>Thank you,</p>\n"
"                    <p style=\"color:#888888;\">\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p>Bonjour <t t-esc=\"object.partner_id.name\"/>\n"
"                        <t t-set=\"access_url\" t-value=\"object.get_contract_url()\"/>\n"
"    \n"
"                        <t t-if=\"object.partner_id.parent_id\">\n"
"                            (<i><t t-esc=\"object.partner_id.parent_id.name\"/></i>)\n"
"                        </t>\n"
"                    ,</p>\n"
"                    <p>Nous vous informons que votre abonnement à l’offre <t t-esc=\"object.plan_id.name\"/> a expiré.</p>\n"
"                    <p>\n"
"                        Veuillez renouveler votre contrat afin de continuer à bénéficier des services de l’offre. Vous pouvez acheter autant de cycles que nécessaire pour l’offre.\n"
"                    </p>                \n"
"                    <p>\n"
"                        Veuillez renouveler l’abonnement avant la fin de votre instance.\n"
"                    </p>\n"
"                    <br/>\n"
"                    <p>\n"
"                        Pour renouveler l’offre actuelle, cliquez sur <a t-att-href=\"access_url\">Renouveler maintenant</a>\n"
"                    </p>\n"
"                    <br/>\n"
"                    <p>\n"
"                        Date de début : <t t-esc=\"object.start_date\"/><br/>\n"
"                        Date d’expiration : <t t-esc=\"object.next_invoice_date\"/><br/>\n"
"                    </p>\n"
"                    <p>\n"
"                        Pour toute question ou difficulté, veuillez contacter notre équipe d’assistance.\n"
"                    </p>\n"
"                    <br/><br/>\n"
"                    <br/>\n"
"                    <p>Merci,</p>\n"
"                    <p style=\"color:#888888;\">\n"
"                    </p>\n"
"                </div>\n"
"            "

#. module: odoo_saas_kit
#: model:mail.template,body_html:odoo_saas_kit.client_subdomain_template
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p>Dear <t t-esc=\"object.partner_id.name\"/>\n"
"                        <t t-set=\"access_url\" t-value=\"object.get_subdomain_url()\"/>\n"
"                        <t t-set=\"access_name\" t-value=\"'Create Your Domain Name'\"/>\n"
"    \n"
"                        <t t-if=\"object.partner_id.parent_id\">\n"
"                            (<i><t t-esc=\"object.partner_id.parent_id.name\"/></i>)\n"
"                        </t>\n"
"                    ,</p>\n"
"                    \n"
"                    <p>We are glad to inform you that your order for the <span t-esc=\"object.invoice_product_id.name\"/> is confirmed.</p>\n"
"                    \n"
"                    <p>The plan you have opted for is <t t-esc=\"object.plan_id.name\"/> of the Plan.</p>\n"
"                    <p>\n"
"                        It is a subscription based plan which means that the plan would remain active from the date of activation. <br/>\n"
"                        Post the expiration of the plan the Instance will expire.<br/>\n"
"                        To avoid this, please renew your plan before the expiration date.\n"
"                    </p>\n"
"                    <p>\n"
"                        Commencement Date: <span t-esc=\"object.start_date\"/><br/>\n"
"                        Next Invoice Date: <span t-esc=\"object.next_invoice_date\"/><br/>\n"
"                        Total Number Of Billing Cycles: <span t-esc=\"object.total_cycles\"/><br/>\n"
"                        Trial period included: <span t-esc=\"object.trial_period\"/> days<br/> \n"
"                    </p>\n"
"                    <p>\n"
"                        If you have any queries or issues, please contact our support team.\n"
"                    </p>\n"
"    \n"
"                    <br/><br/>\n"
"                    <center>\n"
"                        <span> <a t-att-href=\"access_url\" style=\"background-color: #1abc9c; padding: 20px; text-decoration: none; color: #fff; border-radius: 5px; font-size: 16px;\" class=\"o_default_snippet_text\"><t t-esc=\"access_name\"/></a></span>\n"
"                        <br/><br/><br/>\n"
"                    </center>\n"
"                    <br/>\n"
"                    <p>\n"
"                        Once the Domain is successfully created, you will receive the URL of your Odoo Instance along with the login Id and password via mail.\n"
"                    </p>\n"
"                    <p>If you have any query or issues please contact our Support Team.</p>\n"
"    \n"
"                    <p>Thank you,</p>\n"
"    \n"
"                    <p style=\"color:#888888;\">\n"
"                    </p>\n"
"\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p>Bonjour <t t-esc=\"object.partner_id.name\"/>\n"
"                        <t t-set=\"access_url\" t-value=\"object.get_subdomain_url()\"/>\n"
"                        <t t-set=\"access_name\" t-value=\"'Créer votre nom de domaine'\"/>\n"
"    \n"
"                        <t t-if=\"object.partner_id.parent_id\">\n"
"                            (<i><t t-esc=\"object.partner_id.parent_id.name\"/></i>)\n"
"                        </t>\n"
"                    ,</p>\n"
"                    \n"
"                    <p>Nous avons le plaisir de vous informer que votre commande pour <span t-esc=\"object.invoice_product_id.name\"/> est confirmée.</p>\n"
"                    \n"
"                    <p>L’offre que vous avez choisie est <t t-esc=\"object.plan_id.name\"/> .</p>\n"
"                    <p>\n"
"                        Il s’agit d’une offre par abonnement qui reste active à compter de sa date d’activation. <br/>\n"
"                        À l’expiration de l’offre, l’instance arrivera également à expiration.<br/>\n"
"                        Pour éviter cette interruption, veuillez renouveler votre offre avant sa date d’expiration.\n"
"                    </p>\n"
"                    <p>\n"
"                        Date de début : <span t-esc=\"object.start_date\"/><br/>\n"
"                        Date de la prochaine facture : <span t-esc=\"object.next_invoice_date\"/><br/>\n"
"                        Nombre total de cycles de facturation : <span t-esc=\"object.total_cycles\"/><br/>\n"
"                        Période d’essai incluse : <span t-esc=\"object.trial_period\"/> jours<br/> \n"
"                    </p>\n"
"                    <p>\n"
"                        Pour toute question ou difficulté, veuillez contacter notre équipe d’assistance.\n"
"                    </p>\n"
"    \n"
"                    <br/><br/>\n"
"                    <center>\n"
"                        <span> <a t-att-href=\"access_url\" style=\"background-color: #1abc9c; padding: 20px; text-decoration: none; color: #fff; border-radius: 5px; font-size: 16px;\" class=\"o_default_snippet_text\"><t t-esc=\"access_name\"/></a></span>\n"
"                        <br/><br/><br/>\n"
"                    </center>\n"
"                    <br/>\n"
"                    <p>\n"
"                        Une fois le domaine créé avec succès, vous recevrez par e-mail l’URL de votre instance Odoo ainsi que l’identifiant de connexion et le mot de passe.\n"
"                    </p>\n"
"                    <p>Pour toute question ou difficulté, veuillez contacter notre équipe d’assistance.</p>\n"
"    \n"
"                    <p>Merci,</p>\n"
"    \n"
"                    <p style=\"color:#888888;\">\n"
"                    </p>\n"
"\n"
"                </div>\n"
"            "

#. module: odoo_saas_kit
#: model:mail.template,body_html:odoo_saas_kit.client_credentials_template
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    Dear <t t-esc=\"object.partner_id.name\"/><br/><br/>\n"
"                    <p>\n"
"                        Greetings of the Day. <br/>\n"
"                        Your Instance has been successfully created.<br/>\n"
"                        Kindly visit the following link to login to your Odoo Server. &gt;&gt; <a t-att-href=\"object.client_url\"><t t-esc=\"object.client_url\"/></a><br/>\n"
"                        </p><p t-if=\"object.temp_password\" style=\"margin-top:20px;\">\n"
"                            Your Temporary Password is : <code style=\"background-color: honeydew;\"><t t-esc=\"object.temp_password\"/></code> <br/>\n"
"                            You can reset the temporary password by logging in to the saas instance.\n"
"                        </p>\n"
"                        <t t-else=\"\">\n"
"                            Please reset password using the following URL.<br/>\n"
"                            <a t-att-href=\"object.invitation_url\"><t t-esc=\"object.invitation_url\"/></a>\n"
"                        </t>\n"
"                    \n"
"                    <p>\n"
"                        You can always check the details of your previous and current plans from your Website account. \n"
"                        To manage your plans please go to the website account.\n"
"                    </p>\n"
"                    <p>Thank you</p>\n"
"                    <p style=\"color:#888888;\">\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    Bonjour <t t-esc=\"object.partner_id.name\"/><br/><br/>\n"
"                    <p>\n"
"                        Nous vous souhaitons une excellente journée. <br/>\n"
"                        Votre instance a été créée avec succès.<br/>\n"
"                        Veuillez utiliser le lien suivant pour vous connecter à votre serveur Odoo. &gt;&gt; <a t-att-href=\"object.client_url\"><t t-esc=\"object.client_url\"/></a><br/>\n"
"                        </p><p t-if=\"object.temp_password\" style=\"margin-top:20px;\">\n"
"                            Votre mot de passe temporaire est : <code style=\"background-color: honeydew;\"><t t-esc=\"object.temp_password\"/></code> <br/>\n"
"                            Vous pouvez modifier le mot de passe temporaire après vous être connecté à l’instance SaaS.\n"
"                        </p>\n"
"                        <t t-else=\"\">\n"
"                            Veuillez réinitialiser votre mot de passe à l’aide de l’URL suivante.<br/>\n"
"                            <a t-att-href=\"object.invitation_url\"><t t-esc=\"object.invitation_url\"/></a>\n"
"                        </t>\n"
"                    \n"
"                    <p>\n"
"                        Vous pouvez consulter à tout moment les détails de vos offres précédentes et actuelles depuis votre compte sur le site web. Pour gérer vos offres, accédez à votre compte sur le site web.\n"
"                    </p>\n"
"                    <p>Merci</p>\n"
"                    <p style=\"color:#888888;\">\n"
"                    </p>\n"
"                </div>\n"
"            "

