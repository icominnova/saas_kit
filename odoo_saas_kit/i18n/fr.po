msgid ""
"<span/>\n"
"                                <span class=\"text-muted\">Select a product to calculate user pricing in website whose \"User pricing\" must be checked and not related to any plan.</span>\n"
"                                <br/>\n"
"                                <span/>\n"
"                                <span class=\"text-muted\">Notes:</span>\n"
"                                <br/>\n"
"                                <span/>\n"
"                                <span class=\"text-muted\">1. Minimum numbers of user shows that client have to be charge for minimum user.</span>\n"
"                                <br/>\n"
"                                <span/>\n"
"                                <span class=\"text-muted\">2. End user is not allowed to create users more than Max No. of users.</span>\n"
"                                <br/>\n"
"                                <span/>\n"
"                                <span class=\"text-muted\">3. Enter -1 in Max. No. of users to let the end user create inifinite number of users.</span>\n"
"                                <br/>\n"
"                                <span/>\n"
"                                <span class=\"text-muted\">4. Billing of extra users created in client's instance will be included in next month invoice.</span>"
msgstr ""
"<span/>\n"
"                                <span class=\"text-muted\">Sélectionnez un produit pour calculer la tarification par utilisateur sur le site web. Le champ « Tarification par utilisateur » du produit doit être activé et le produit ne doit être lié à aucune offre.</span>\n"
"                                <br/>\n"
"                                <span/>\n"
"                                <span class=\"text-muted\">Remarques :</span>\n"
"                                <br/>\n"
"                                <span/>\n"
"                                <span class=\"text-muted\">1. Le nombre minimum d’utilisateurs indique le nombre minimal d’utilisateurs qui sera facturé au client.</span>\n"
"                                <br/>\n"
"                                <span/>\n"
"                                <span class=\"text-muted\">2. L’utilisateur final ne peut pas créer plus d’utilisateurs que le nombre maximal autorisé.</span>\n"
"                                <br/>\n"
"                                <span/>\n"
"                                <span class=\"text-muted\">3. Saisissez -1 dans le nombre maximal d’utilisateurs pour autoriser un nombre illimité d’utilisateurs.</span>\n"
"                                <br/>\n"
"                                <span/>\n"
"                                <span class=\"text-muted\">4. La facturation des utilisateurs supplémentaires créés dans l’instance du client sera incluse dans la facture du mois suivant.</span>"

