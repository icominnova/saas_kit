<odoo>
    <data>
        <record id="contract_creation_wizard_inherited_view" model="ir.ui.view">
            <field name="name">contract.creation.wizard.inherit.form.saas</field>
            <field name="model">saas.contract.creation</field>
            <field name="inherit_id" ref="odoo_saas_kit.contract_creation_wizard_view" />
            <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_product_id']" position="after">
                <field name="trial_invoice_product" invisible="trial_period == 0" 
                readonly="True"
                />
            </xpath>
            </field>
        </record>
    </data>
</odoo>