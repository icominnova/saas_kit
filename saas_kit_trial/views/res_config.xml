<odoo>
    <data>
        <record id="res_config_settings_inheri_view_form" model="ir.ui.view">
            <field name="name">res.config.setting.inherit.form.saas</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval='21' />
            <field name="inherit_id" ref="odoo_saas_kit.res_config_settings_inheri_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//block[hasclass('saas_kit_setting_block')]/setting[2]" position="replace">
                    <setting class = "col-12" id="saas_kit_schedule_create_client" string="Auto Purchase Reminder of Trial" help="Automatically Send Reminder to Client for Payment after Expiration of Trial Period">
                            <field name="auto_purchase_reminder" />
                            <!-- <label for="auto_purchase_reminder" string="Auto Purchase Reminder of Trial"/> -->
                            <!-- <div class="text-muted">
                                Automatically Send Reminder to Client for Payment after Expiration of Trial Period
                            </div> -->
                            <div class="row mt-2" invisible = "not auto_purchase_reminder">
                                <!-- <div class="col-1">
                                </div> -->
                                <div class="col-md-12">
                                    <div>
                                        <label for="reminder_mail_count" string="Purchase reminder ends after (mails)" class="o_light_label"/>
                                        <field class="oe_inline ms-2" name="reminder_mail_count" required="1"/>
                                    </div>
                                </div>
                            </div>
                    </setting>
                </xpath>
                <xpath expr="//setting[@id='saas_kit_renew_mail']" position="after">
                    <setting id="saas_kit_trial_renew_mail" class="col-12 pt-5" invisible="not enable_renew_mail">
                        <div class="col-xs-12 o_setting_box mt-3" id="saas_kit_renew_mail_div" invisible="not enable_renew_mail">
                            <div class="row mt-5">
                                <div class="col-md-12">
                                    <div class="o_setting_left_pane">
                                        <field name="enable_renew_mail_trial_contract"/>
                                    </div>
                                    <label for="enable_renew_mail_trial_contract" string="For Trial Contract"/>
                                </div>
                                <br/>
                                <br/>
                                <div class="row">
                                    <div class="col-md-12" invisible="not enable_renew_mail_trial_contract">
                                        <div>
                                            <label for="renew_period_trial_contract" string="Renew Reminders ends after (days)" class="o_light_label"/>
                                            <field class="oe_inline ms-2" name="renew_period_trial_contract" required="1"/>
                                        </div>
                                        <div class="text-muted">
                                            For Trial Contract Renew mails will sent to Customer.
                                        </div>
                                        <br/>
                                        <div>
                                            <label for="no_of_mails_trial_contract" string="No of Expiry mails" class="o_light_label"/>
                                            <field class="oe_inline ms-2" name="no_of_mails_trial_contract" required="1" value="3"/>
                                        </div>
                                        <div class="text-muted">
                                            No of mail should be less than or equal to Renew period.
                                        </div>
                                        <br/>
                                        <div>
                                            <field name="stop_client_trial_contract" class="d-inline"/>
                                            <label for="stop_client_trial_contract" string="Automatic Disable expired Saas Client Instances" class="d-inline o_light_label" />
                                        </div>
                                        <div class="row mt-2">
                                            <div class="col-11 offset-1" invisible="not stop_client_trial_contract">
                                                <div invisible="not stop_client_trial_contract">
                                                    <field name="drop_trial_contract"/>
                                                    <label for="drop_trial_contract" string="Delete Client Instances" invisible="not stop_client_trial_contract" class="o_light_label"/>
                                                    <br/>
                                                    <div class="text-muted" invisible="not stop_client_trial_contract">
                                                        If selected related Saas Client container and database would be dropped.
                                                    </div>
                                                </div>
                                                <div class="row mt-2" invisible="not drop_trial_contract">
                                                    <div class="col-11 offset-1" >
                                                        <label for="buffer_trial_contract" string="Buffer Period" class="o_light_label"/>
                                                        <field class="oe_inline ms-2" name="buffer_trial_contract" required="1" value="3"/>
                                                        <div class="text-muted" invisible="not drop_trial_contract">
                                                            Disabled client would be dropped after this Buffer Period
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </setting>
                </xpath>

            </field>
        </record>
    </data>
</odoo>
