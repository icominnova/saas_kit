<odoo>
    <data>
        <record id="saas_client_backup_form_view" model="ir.ui.view">
            <field name="name">Client Inherit Form</field>
            <field name="model">saas.client</field>
            <field name="inherit_id" ref="odoo_saas_kit.saas_client_form_view" />
            <field name="arch" type="xml">
                <xpath expr="//button[@name='fetch_client_url']" position="after">
                    <field name="is_crone_ignited" invisible="1"/>
                    <field name="crone_state" invisible="1"/>
                    <button string="Create Backup Process" name="saas_kit_backup.backup_process_wizard_action" type="action" class="oe_highlight" invisible="(state != 'started') or (crone_state != 'cancel' and backup_process_id)"/>                    
                    <button string="Update Backup Process" name="update_backup_process" type="object" class="oe_highlight" invisible="(state != 'started') or (not backup_process_id) or (crone_state == 'cancel')"/>                    
                    <button type="object" string="Cancel Backup Process" name="cancel_backup_process" invisible="(state != 'started') or (not backup_process_id) or (crone_state == 'cancel')" />
                </xpath>
                <xpath expr="//page[2]" position="after">
                    <page name="backup_details" string="Backup Details" invisible="(not backup_process_id)">
                        <group name="outer_left">
                            <group name="inner_left">
                                <field name="backup_process_id" readonly="crone_state in ['confirm', 'running']"/>
                                <field name="backup_format" readonly="crone_state in ['confirm', 'running']"/>
                                <field name="frequency_cycle" readonly="crone_state in ['confirm', 'running']"/>
                            </group>
                            <group name="inner_right">
                                <field name="backup_path" readonly="crone_state in ['confirm', 'running']"/>
                                <field name="backup_location" readonly="crone_state in ['confirm', 'running']"/>
                            </group>
                        </group>

                        <field name="backup_details_ids" readonly="1">
                            <list editable="bottom" create='false'>
                                <field name="backup_date_time" readonly="1" />
                                <field name="file_name" readonly="1" />
                                <field name="status" readonly="1" />
                                <field name="message" readonly="1" />
                                <field name="backup_location" invisible="1" />
                                <button name="unlink_confirmation" type="object" title="Delete"  icon="fa-trash" class="btn-secondary me-2 text-muted" />
                                <button name="download_db_file" type="object" string="Download" class="oe_highlight" attrs="{'invisible': [('status', '!=', 'Success')]}"/>
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
