<odoo>
    <data noupdate="0">
        <record id="saas_kit_backup.backup_creation_template" model="mail.template">
            <field name="name">SaaS Backup Creation Mail</field>
            <field name="email_from">{{ (user.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="subject">SaaS Client Backup Process Creation</field>
            <field name="model_id" ref="odoo_saas_kit.model_saas_client"/>
            <field name="auto_delete" eval="False"/>
            <field name="lang">{{object.partner_id.lang}}</field>
            <field name="body_html" type="html">

                <div style="margin: 0px; padding: 0px;">
                    Dear SaaS Admin, <br/>

                    <p>Greetings of the Day.</p>
                    <p>A new saas client instance backup request has been created for saas client <strong><t t-esc="object.name" /></strong>.</p>

                    <p>Kindly proceed with the confirmation of the Backup Process <strong><t t-esc="object.backup_process_id.name"/></strong>.</p>

                    <p>Thank you</p>
                </div>
            </field>
        </record>
    </data>
</odoo>
